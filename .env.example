# Copy to .env.local for local development (never commit real values).
# In production, set these in Vercel -> Project -> Settings -> Environment Variables.

# PIN the group admin types to unlock editing (fund, tiers, goals, schedule).
# Data is stored in Upstash Redis; without Redis the deployed page is read-only
# (locally it falls back to .data/soccer.json).
SOCCER_ADMIN_PIN=

# Upstash Redis (free tier, or the Vercel Marketplace integration which sets
# KV_REST_API_URL / KV_REST_API_TOKEN instead - both are supported).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional salt for hashing visitor IPs in rate-limit keys
RATE_LIMIT_SALT=
# Optional: extra comma-separated origins allowed to call the API
ALLOWED_ORIGINS=
